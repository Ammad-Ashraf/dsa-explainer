# Copy this file to .env and fill in ONE provider.
# Every provider below speaks the OpenAI chat-completions API, so only these
# three lines change. Check your settings (run inside backend/):  python -m dsa_explainer.authoring.llm

# Google Gemini: free tier, key from https://aistudio.google.com/apikey
# (list the models your key can use:  python -m dsa_explainer.authoring.llm --models)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# The free tier allows only 20 requests a day per model; after that the app switches to this one.
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq: free tier, key from https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=

# Anthropic Claude: paid, key from https://console.anthropic.com
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=

# Local Ollama: no key and no internet, but slower and less accurate
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama

# Optional
# LLM_TEMPERATURE=0.4
# MAX_ATTEMPTS=4            # first plan + repairs before giving up
# KOKORO_VOICE=af_heart     # other voices: am_michael, bf_emma, ...
# KOKORO_MODEL=models/kokoro/kokoro-v1.0.onnx
# RENDER_WORKERS=4          # clips drawn at the same time (default: half the CPU threads, at most 4)
